# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DATA_ROOT=./artifacts/data
MODEL_ROOT=./artifacts/models
RUN_ROOT=./artifacts/runs
WORKSPACE_ROOT=./artifacts/work

# ---------------------------------------------------------------------------
# Models. Editor size is chosen automatically from detected VRAM unless you
# pin it here. See src/autofix/training/sizing.py for the sizing table.
# ---------------------------------------------------------------------------
RERANKER_BASE=Qwen/Qwen2.5-Coder-1.5B-Instruct
EDITOR_BASE=Qwen/Qwen2.5-Coder-32B-Instruct
# Override auto-sizing: 7b | 14b | 32b
EDITOR_SIZE_OVERRIDE=
# Override auto-sizing for sequence length (tokens)
MAX_SEQ_LEN_OVERRIDE=

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# HuggingFace caches every downloaded dataset here. The corpora in this project
# run to tens of GB, which will blow a typical HPC home quota. Point this at
# scratch BEFORE the first `autofix-data` run - moving it afterwards means
# re-downloading everything.
#   HF_HOME=/scratch/$USER/hf-cache
# Set it in your shell (and ~/.bashrc), not here: it is read by the datasets
# library directly, not by this project's settings.
# Optional: raises GitHub's anonymous 60/hr rate limit to 5000/hr when mining.
GITHUB_TOKEN=
# Benchmarks to hold out. Any training instance whose repo+base_commit appears
# in these is dropped. Never remove SWE-bench from this list.
EVAL_BENCHMARKS=princeton-nlp/SWE-bench_Lite,princeton-nlp/SWE-bench_Verified
RETRIEVAL_CANDIDATES=50
RETRIEVAL_KEEP=5

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
LEARNING_RATE=1e-4
NUM_EPOCHS=2
WARMUP_RATIO=0.03
GRAD_ACCUM=16
SEED=42

# ---------------------------------------------------------------------------
# Rejection sampling
# ---------------------------------------------------------------------------
SAMPLES_PER_ISSUE=8
SAMPLING_TEMPERATURE=0.8
SAMPLING_TOP_P=0.95
MAX_VERIFY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Inference server (vLLM)
# ---------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# ---------------------------------------------------------------------------
# Sandbox (unchanged from v1 - this is now the reward function)
# ---------------------------------------------------------------------------
DOCKER_HOST=
SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_QUOTA=2.0
SANDBOX_MEMORY_MB=4096
SANDBOX_PIDS_LIMIT=512
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_INSTALL_TIMEOUT_SECONDS=600
SANDBOX_ALLOW_INSTALL_NETWORK=true

# ---------------------------------------------------------------------------
# Patch scope limits (unchanged - reject malformed patches before spending a
# test run on them)
# ---------------------------------------------------------------------------
MAX_FILES_CHANGED=5
MAX_LINES_CHANGED=200
MAX_SINGLE_FILE_LINES=120
PROTECTED_PATHS=.github/**;**/*.lock;**/Dockerfile*;**/setup.py;**/pyproject.toml;**/package.json

LOG_LEVEL=INFO
LOG_JSON=false
